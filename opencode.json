{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "apiKey": "{env:OPENCODE_API_KEY}",
  "mcp": {
    "hackswarm-hub": {
      "type": "local",
      "command": ["python", "central_hub/mcp_server/server.py"],
      "enabled": true,
      "environment": {
        "DATABASE_URL": "sqlite:///./central_hub/database/swarm.db"
      }
    }
  }
}
