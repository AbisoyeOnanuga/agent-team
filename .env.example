# ==========================================
# HackSwarm Environment Configuration
# ==========================================

# Network & Host (Tailscale Mesh recommended)
CENTRAL_HUB_HOST=0.0.0.0
CENTRAL_HUB_PORT=8000
# Example Tailscale IP of your powerhouse laptop:
CENTRAL_HUB_URL=http://100.64.0.10:8000

# Database & Memory
DATABASE_URL=sqlite:///./central_hub/database/swarm.db
CHROMA_PERSIST_DIR=./central_hub/memory/chroma_data

# Ollama LLM / Embeddings
# The always-on PC hosts the hub. A 3060 laptop (6GB class) can host the 7B model instead:
# OLLAMA_BASE_URL=http://100.64.0.11:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen2.5:7b-instruct uses ~4.5GB VRAM (fits comfortably inside 6GB VRAM with fast GPU inference)
OLLAMA_CODE_MODEL=qwen2.5:7b-instruct
OLLAMA_ROUTER_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==========================================
# Zero-Cost LLM Providers (from free-llm.com)
# All of these offer permanent free tiers with NO credit card required
# ==========================================

# 1. Groq (Skipped - requires balance)
# GROQ_API_KEY=

# 2. Google AI Studio (Gemini 2.0 Flash, 1M context, 1,500 req/day) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Mistral / Codestral (Specialized in code generation) - https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_mistral_api_key_here

# 4. OpenRouter Free Tier (DeepSeek-R1:free, Llama-3.3-70B:free) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 5. NVIDIA NIM (Llama 70B & DeepSeek reasoning, 1,000 free credits) - https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenCode Console API Key
OPENCODE_API_KEY=your_opencode_api_key_here

# Subscription Proxy Options (Optional)
# If using GitHub Copilot proxy (copilot-gpt4-service):
COPILOT_PROXY_URL=http://localhost:8080/v1
# If using Central LiteLLM Router:
LITELLM_PROXY_URL=http://100.64.0.10:4000/v1

# Phone dispatch console
# Open http://<tailscale-ip>:3000 on the phone. Do not port-forward 8787 or 3000.
CONSOLE_PIN=change-me
CONSOLE_SECURE=0
HACKSWARM_WORKER=1
# gemini, mistral, openrouter, nvidia, ollama
HACKSWARM_PROVIDER=gemini
# Optional buzz when a gate opens. The topic is a secret. Decisions stay in the console.
# NTFY_TOPIC=

# Teammate Client Settings
TEAMMATE_NAME=Developer-1
PREFERRED_CODER=aider  # options: 'aider' or 'openhands'
OPENHANDS_CONTAINER_IMAGE=ghcr.io/all-hands-ai/openhands:latest

